  {
    "nombre": "ERP Masterbus",
    "tipo": "pull",
    "url": "https://mantenimiento.masterbus.net/",
    "plataforma": "propio",
    "es_dependencia": true,
    "funcion": {
      "descripcion": "Login real (Laravel: CSRF + sesión, toca usuarios)",
      "requiere_secrets": ["ERP_EMAIL", "ERP_PASS"],
      "pasos": [
        {
          "nombre": "abrir-login",
          "url": "https://mantenimiento.masterbus.net/login",
          "metodo": "GET",
          "extraer": { "var": "csrf", "regex": "name=\"_token\"[^>]*value=\"([^\"]+)\"" },
          "espera": { "status": 200, "texto_incluye": "_token" }
        },
        {
          "nombre": "login",
          "url": "https://mantenimiento.masterbus.net/login",
          "metodo": "POST",
          "cuerpo_form": { "_token": "var:csrf", "email": "env:ERP_EMAIL", "password": "env:ERP_PASS" },
          "no_seguir_redirect": true,
          "espera": { "status": 302, "location_no_incluye": "/login" }
        }
      ]
    }
  },
